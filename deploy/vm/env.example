# ~/.config/goobreview/env (mode 0600). Plain KEY=value lines, no secrets.
GOOBREVIEW_APP_ID=123456
GOOBREVIEW_APP_PRIVATE_KEY_FILE=/var/lib/goobreview/app-key.pem
GOOBREVIEW_WORK_DIR=/var/lib/goobreview/v2-work
# Leave unset to review every repo the App is installed on (filtered by the
# config's "repos" allowlist). Set it only to pin a single installation.
# GOOBREVIEW_APP_INSTALLATION_ID=
